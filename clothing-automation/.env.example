# ---------- IA (legenda do post) — escolha UMA chave (todas free tier, exceto Claude) ----------
# Prioridade no modo automático: Groq -> Gemini -> Claude -> mock
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Entrada das fotos ----------
# Caminho padrão: TELEGRAM. Você encaminha a foto da fornecedora do WhatsApp para o
# seu bot, com o preço de custo na legenda. Sem servidor, sem webhook, sem custo.
# Crie o bot com o @BotFather no Telegram e cole o token aqui.
TELEGRAM_BOT_TOKEN=

# Alternativa: provedor de WhatsApp que acumule as mensagens num endpoint JSON.
# (deixe em branco se usar Telegram)
WHATSAPP_INBOX_URL=
WHATSAPP_INBOX_TOKEN=

# Força uma fonte específica: telegram | inbox | mock. Em branco = detecta sozinho.
SOURCE_PROVIDER=

# ---------- Instagram (saída dos posts) — Instagram Graph API (conta Business/Creator) ----------
# ID da conta do Instagram (Instagram Business Account ID) e token de longa duração.
IG_USER_ID=
IG_ACCESS_TOKEN=
